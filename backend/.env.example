APP_NAME=DripZone Admin API
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=3000
APP_DEBUG=true
API_PREFIX=/api
DATABASE_URL=postgresql+psycopg://dripzone:troque_a_senha@127.0.0.1:5432/dripzone
SESSION_SECRET_KEY=change-this-local-development-secret
SESSION_COOKIE_NAME=dripzone_admin_session
SESSION_MAX_AGE=28800
SESSION_COOKIE_SAMESITE=lax
CORS_ORIGINS=http://127.0.0.1:4173,http://localhost:4173,http://127.0.0.1:4199,http://localhost:4199
UPLOAD_DIRECTORY=storage/uploads
PUBLIC_PRODUCTS_PATH=
LOG_LEVEL=INFO
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
IMPORT_IMAGE_MAX_BYTES=10485760
IMPORT_IMAGE_CONNECT_TIMEOUT=5
IMPORT_IMAGE_READ_TIMEOUT=15
IMPORT_IMAGE_MAX_REDIRECTS=3
IMPORT_IMAGE_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
IMPORT_IMAGE_MAX_WIDTH=12000
IMPORT_IMAGE_MAX_HEIGHT=12000
IMPORT_IMAGE_MAX_PIXELS=40000000
IMPORT_IMAGE_STORAGE_ROOT=imports
IMPORT_IMAGE_PUBLIC_PREFIX=/uploads/imports
IMPORT_IMAGE_MAX_PER_ITEM=12
IMPORT_IMAGE_MAX_PER_REQUEST=20
IMPORT_ALLOWED_HOSTS=example.com,www.example.com,yupoo.com,www.yupoo.com
IMPORT_ALLOWED_DOMAINS=yupoo.com
IMPORT_MAX_PAGES=5
IMPORT_MAX_ITEMS=50
IMPORT_REQUEST_TIMEOUT=10
IMPORT_REQUEST_DELAY=0.2
IMPORT_MAX_RETRIES=2
IMPORT_MAX_RESPONSE_BYTES=2097152
IMPORT_USER_AGENT=DripZoneImportPreview/1.0
