# Este arquivo pode ser versionado.
# Copie para .env e altere a senha antes de iniciar o PostgreSQL.
# Nunca envie a senha real ao Git.

POSTGRES_DB=dripzone
POSTGRES_USER=dripzone
POSTGRES_PASSWORD=troque_por_uma_senha_forte
POSTGRES_PORT=5432

# Producao local via compose.prod.yaml.
# Use valores reais apenas no .env, nunca neste exemplo.
SESSION_SECRET_KEY=troque_por_um_segredo_com_mais_de_32_caracteres
DATABASE_URL=postgresql+psycopg://dripzone:troque_por_uma_senha_forte@postgres:5432/dripzone
CORS_ORIGINS=https://dripzone.com.br
DRIPZONE_SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
LOG_LEVEL=INFO
